rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /words/{wordId} {
      allow read: if true;
      allow create, update: if request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.language in ['pt', 'en']
        && request.resource.data.difficulty in ['easy', 'medium', 'hard'];
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.sessionId == sessionId;
      allow update: if request.resource.data.sessionId == sessionId
        && resource.data.sessionId == sessionId;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['running', 'finished']
        && request.resource.data.pauseCount >= 0
        && request.resource.data.pauseCount <= 3;
      allow update: if resource.data.status in ['running', 'paused']
        && request.resource.data.status in ['running', 'paused', 'finished']
        && request.resource.data.pauseCount >= resource.data.pauseCount
        && request.resource.data.pauseCount <= 3
        && (
          resource.data.status == 'running'
          || (
            request.resource.data.wordsCompleted == resource.data.wordsCompleted
            && request.resource.data.score == resource.data.score
          )
        );
      allow delete: if false;
    }

    match /rankings/{rankingId} {
      allow read: if true;
      allow create: if request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.score is number
        && request.resource.data.score > 0;
      allow update: if request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.score is number
        && request.resource.data.score >= resource.data.score
        && (
          !('sessionId' in resource.data)
          || resource.data.sessionId == ''
          || request.resource.data.sessionId == resource.data.sessionId
        );
      allow delete: if true;
    }
  }
}
